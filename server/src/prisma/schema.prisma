generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Anomaly {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now()) @map("created_at")
  date         DateTime
  usageKwh     Float    @map("usage_kwh")
  co2Tco2      Float    @map("co2_tco2")
  powerFactor  Float    @map("power_factor")
  anomalyLabel String   @map("anomaly_label")
  fmeaDiagnosis String  @map("fmea_diagnosis")
  alertLevel   String      @map("alert_level")
  fileId       String   @map("file_id")

  @@map("anomalies")
}